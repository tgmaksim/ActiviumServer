# ===== BASE PARAMS =====
PROJECT_NAME=Activium
VERSION=0.0.1
DEBUG=1
URL=http://localhost:3000
WWW_PATH=/home/www

# ===== Github =====
GITHUB=https://github.com/Activium
GITHUB_SERVER=https://github.com/ActiviumServer

# ===== Hosting API =====
NETANGELS_GATEWAY_TOKEN_URL=https://panel.netangels.ru/api/gateway/token/
NETANGELS_API_KEY=key
NETANGELS_API_URL=https://api-ms.netangels.ru/api/v2/hosting
VIRTUALHOST_ID=0
LOGS_PGADMIN_OPEN=https://pgadmin.hosting.com/?min_created_at={min_created_at}&max_created_at={max_created_at}

# ===== AI =====
OPENROUTER_API_KEY=key

# ===== TELEGRAM BOT =====
BOT_TOKEN=bot_id:test
ADMIN_CHAT_IDS='[0]'
BOT_URL=https://t.me/username

# ===== API =====
API_KEY=test
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_PREFIX=/api/v2
APK_PREFIX=/apk
HIDE_VALIDATION_ERRORS_IN_DOCS=1
TEMPLATES_DIRECTORY=templates

# ===== DNEVNIK =====
DNEVNIK_CLIENT_ID=key

# ===== AUTHOR =====
AUTHOR=tgmaksim
AUTHOR_LINK=https://tgmaksim.ru
ADMIN_TIMEZONE=0

# ===== POSTGRES DOCKER =====
DB_SCHEME=postgresql+asyncpg
DB_HOST=db
DB_NAME=app_db
DB_USER=postgres
DB_PASS=postrgres
DB_PORT=5432
DB_ECHO=1
