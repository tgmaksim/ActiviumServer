# Переменные окружения для production-запуска

# ===== BASE PARAMS =====
PROJECT_NAME=Activium
VERSION=0.0.1
DEBUG=0
URL=https://example.com
WWW_PATH=/home/app/www
RESOURCES_PATH=resources

# ===== Server =====
COUNT_SERVER_WORKERS=1
START_TGBOT_WORKER=1
COUNT_MARKS_NOTIFICATIONS_WORKERS=1
START_MARKS_NOTIFICATIONS_WORKER=1
COUNT_EA_NOTIFICATIONS_WORKERS=1
START_EA_NOTIFICATIONS_WORKER=1
COUNT_NOTES_NOTIFICATIONS_WORKERS=1
START_NOTES_NOTIFICATIONS_WORKER=1

# ===== Github =====
GITHUB=https://github.com/tgmaksim/Activium
GITHUB_SERVER=https://github.com/tgmaksim/ActiviumServer

# ===== Hosting API =====
HOSTING_GATEWAY_TOKEN_URL=https://example.com/api/gateway/token/
HOSTING_API_KEY=key
HOSTING_API_URL=https://api-ms.example.com/api/v2/hosting
VIRTUALHOST_ID=0
LOGS_PGADMIN_OPEN=https://pgadmin.hosting.com/?min_created_at={min_created_at}&max_created_at={max_created_at}

# ===== AI =====
OPENAI_URL=https://example.com/v1
OPENAI_API_KEY=key
OPENAI_MODEL=openai/gpt-5.4-pro

# ===== Statistics =====
AI_STATISTICS_ANALISE=1

# ===== TELEGRAM BOT =====
BOT_TOKEN=bot_id:token
ADMIN_CHAT_IDS='[0]'
BOT_URL=https://t.me/username

# ===== SCHOOL POSTS =====
TELEGRAM_PREVIEW_URL=https://proxy.com/?url=

# ===== API =====
API_KEY=test
CORS_ALLOWED_ORIGINS='["https://example.com"]'
API_PREFIX=/api/v2
APK_PREFIX=/apk
HIDE_VALIDATION_ERRORS_IN_DOCS=1
TEMPLATES_DIRECTORY=templates

# ===== DNEVNIK =====
DNEVNIK_CLIENT_ID=key

# ===== AUTHOR =====
AUTHOR=tgmaksim
AUTHOR_LINK=https://tgmaksim.ru
ADMIN_TIMEZONE=0

# ===== POSTGRES =====
DB_SCHEME=postgresql+asyncpg
DB_HOST=example.com
DB_NAME=app_db
DB_USER=postgres
DB_PASS=postrgres
DB_PORT=5432
DB_ECHO=0
